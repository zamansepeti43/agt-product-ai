# AGT Product AI — local/remote AI configuration
# Never commit real API keys or private endpoints.

# IMAGE_PROVIDER=comfyui
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_MS=180000
# COMFYUI_WORKFLOW_JSON={"...":"Export your ComfyUI workflow in API format and keep placeholders __IMAGE__, __PROMPT__, __WIDTH__, __HEIGHT__ where applicable."}

# Qwen Image Edit workflow/model is configured inside the ComfyUI workflow.
# The application does not bundle model weights.
# BACKGROUND_PROVIDER=birefnet
# STORAGE_PROVIDER=local
