# AGT Product AI — local/remote AI configuration
# Never commit real keys or private endpoints.

# Select the server-side image provider.
IMAGE_PROVIDER=comfyui

# ComfyUI can run locally or on a GPU server.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT_MS=180000

# Export a ComfyUI API-format workflow JSON and paste it here.
# The adapter replaces these placeholders:
# __IMAGE__ __PROMPT__ __WIDTH__ __HEIGHT__
COMFYUI_WORKFLOW_JSON=

# Planned background provider.
BACKGROUND_PROVIDER=birefnet

# Reserved for the video module.
VIDEO_PROVIDER=

# Client-visible provider label only; no secret belongs here.
NEXT_PUBLIC_IMAGE_PROVIDER=COMFYUI
