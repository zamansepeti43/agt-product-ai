# AGT Product AI — local/remote AI configuration
# Never commit real API keys or private endpoints.

# Default strategy
# IMAGE_PROVIDER=auto-free

# Local ComfyUI / Qwen
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_MS=180000
# COMFYUI_WORKFLOW_JSON={"...":"Export your ComfyUI workflow in API format and keep placeholders __IMAGE__, __PROMPT__, __WIDTH__, __HEIGHT__ where applicable."}

# AI Horde — community/free image generation and img2img
# AIHORDE_API_KEY=
# AIHORDE_MODEL=AlbedoBase XL (SDXL)

# Cloudflare credentials are entered by the app user at runtime.
# Gemini / OpenAI-compatible credentials are also entered by the app user at runtime.
# Pollinations uses OAuth BYOP; only the public App Key is configured in the frontend.

# Qwen Image Edit workflow/model is configured inside ComfyUI.
# The application does not bundle model weights.
# Generated /view assets are proxied through /api/asset for same-origin browser delivery.
# BACKGROUND_PROVIDER=birefnet
# STORAGE_PROVIDER=local

# Pollinations OAuth App Key (public client_id; never put an sk_ secret here)
# NEXT_PUBLIC_POLLINATIONS_APP_KEY=pk_your_agt_app_key
