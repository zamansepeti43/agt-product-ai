# AGT Product AI — local/remote AI configuration
# Never commit real API keys or private endpoints.

# IMAGE_PROVIDER=auto-free
# COMFYUI_BASE_URL=http://127.0.0.1:8188
# COMFYUI_TIMEOUT_MS=180000
# COMFYUI_WORKFLOW_JSON={"...":"Export your ComfyUI workflow in API format and keep placeholders __IMAGE__, __PROMPT__, __WIDTH__, __HEIGHT__ where applicable."}

# Free cloud/community fallback:
# Register an AI Horde account and put its free API key here.
# Anonymous key 0000000000 is intentionally NOT used for uploaded product photos.
# AIHorde API key: https://aihorde.net/register
# AIHorde model defaults to AlbedoBase XL (SDXL).
# AIHorde API image generation is community-powered and free; queue speed varies.
# AIHorde model licensing is model-specific; verify the selected model before commercial use.
# AIHORDE_API_KEY=
# AIHORDE_MODEL=AlbedoBase XL (SDXL)

# Qwen Image Edit workflow/model is configured inside the ComfyUI workflow.
# The application does not bundle model weights.
# Generated /view assets are proxied through /api/asset for same-origin browser delivery.
# BACKGROUND_PROVIDER=birefnet
# STORAGE_PROVIDER=local
